# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
ANTHROPIC_VERSION=2023-06-01

# Google Gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-2.5-flash

# Binance (public market data; key optional, only needed for higher rate limits)
BINANCE_API_KEY=
BINANCE_BASE_URL=https://api.binance.com

# Polymarket — read-only (Gamma public API)
# Hanya POLYMARKET_API_KEY yang dipakai app saat ini (bearer untuk rate-limit lebih tinggi).
POLYMARKET_API_KEY=
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com

# Polymarket — TRADING (opsional, BELUM dipakai oleh app ini).
# Isi hanya jika kamu ingin extend app supaya bisa place order / lihat portofolio.
# Hati-hati: POLYGON_PRIVATE_KEY = kunci wallet on-chain. Jangan commit, jangan taruh di repo publik.
# POLYMARKET_API_SECRET=
# POLYMARKET_API_PASSPHRASE=
# POLYGON_PRIVATE_KEY=
# POLYMARKET_FUNDER_ADDRESS=
# POLYMARKET_SIGNATURE_TYPE=2   # 0=EOA, 1=POLY_PROXY, 2=POLY_GNOSIS_SAFE

# App
DATABASE_URL=sqlite+aiosqlite:///./data/predictions.db
PREDICTION_INTERVAL_MINUTES=5
AGENT_CONCURRENCY=10
AGENT_TIMEOUT_SECONDS=45
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
